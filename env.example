# GitHub App Credentials
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=

# Claude API
ANTHROPIC_API_KEY=

# Gemini API
GOOGLE_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-1.5-pro-latestcommand -v git          # check for Git
command -v python3      # check for Python
command -v node || echo "node missing"
command -v npm  || echo "npm missing"
command -v docker || echo "docker missing"

# Merge Gate
MERGE_GATE_DEFAULT_THRESHOLD=80
MERGE_GATE_THRESHOLD_OVERRIDES=
MERGE_GATE_OVERRIDE_KEYWORD="safe-commit override"

# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/safecommit
